# Aerion, environment.
#
# Every one of these is optional. The repository ships a real, timestamped run
# artifact, so the whole application works with none of them set. Each key
# unlocks a live path, and where a key is absent the interface says so on screen
# rather than failing quietly or pretending.
#
# Copy to .env.local, which is gitignored. Never commit a filled-in copy.

# ── Models ────────────────────────────────────────────────────────────────
# Email prose and the question box. Without either of these the established
# facts still render, unedited, and the absence of copy is recorded as a gap.
GROQ_API_KEY=
NVIDIA_API_KEY=

# ── Contact discovery ─────────────────────────────────────────────────────
# Public professional profiles, where the search result title is the evidence.
# Without it, contacts come from statutory disclosures and company pages only.
SERPER_API_KEY=

# ── Maps ──────────────────────────────────────────────────────────────────
# Satellite basemap. Falls back to keyless Esri World Imagery when unset. This
# one necessarily reaches the browser, since tile requests come from the client,
# so restrict it by domain in the MapTiler dashboard.
MAPTILER_KEY=

# ── Real delivery ─────────────────────────────────────────────────────────
# The only zero-DNS path that can reach an arbitrary reviewer: Gmail SMTP with a
# 16-character app password, which requires 2-Step Verification on the account.
# App passwords are disabled on most managed Workspace tenants, so use a personal
# address. Nothing is ever sent to a prospect; the recipient is whatever an
# operator types into the field on the page.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Persistence ───────────────────────────────────────────────────────────
# Saves live discoveries. Run supabase/schema.sql once in the SQL editor first.
#
# The service role key bypasses row level security, which is correct for a
# server-side writer and is exactly why it must never reach a browser. Row level
# security stays enabled with no anon policy, so a leaked anon key would read
# nothing. Do not add the anon or publishable key here; this app has no use for
# one.
#
# Without these, discoveries are written to data/discoveries locally, and on a
# serverless host the response states plainly that the result was not persisted.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
